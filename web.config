<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ปิด kernel caching -->
    <caching enabled="false" enableKernelCache="false" />

    <!-- ปิด output caching -->
    <serverRuntime frequentHitThreshold="1" />

    <!-- ปิด compression ทั้งหมด (สำคัญสำหรับ SSE) -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
        <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" doStaticCompression="false" doDynamicCompression="false" />
        <dynamicTypes>
            <!-- SSE ต้องไม่ถูกบีบอัด -->
            <add mimeType="text/event-stream" enabled="false" />
            <add mimeType="*/*" enabled="false" />
        </dynamicTypes>
        <staticTypes>
            <add mimeType="text/event-stream" enabled="false" />
            <add mimeType="*/*" enabled="false" />
        </staticTypes>
    </httpCompression>

    <!-- Header สำคัญสำหรับ SSE -->
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-cache" />
        <add name="X-Accel-Buffering" value="no" />
        <add name="Connection" value="keep-alive" />
      </customHeaders>
    </httpProtocol>

    <!-- ปิด ASP Buffering -->
    <asp bufferingEnabled="false" />

    <!-- ปิด static file buffering -->
    <staticContent>
      <remove fileExtension=".event-stream" />
      <mimeMap fileExtension=".event-stream" mimeType="text/event-stream" />
    </staticContent>

  </system.webServer>
</configuration>
